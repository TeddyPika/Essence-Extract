{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/TeddyPika/Essence-Extract/blob/main/schemas/essence-output.schema.json",
  "title": "Essence-Extract HTML report payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "skill",
    "summary",
    "verified_facts",
    "unverified_assumptions",
    "residual_risks",
    "recommended_actions",
    "open_questions"
  ],
  "properties": {
    "skill": {
      "type": "string",
      "enum": [
        "architecture-essence",
        "code-essence",
        "decision-essence",
        "game-design-essence",
        "incident-essence",
        "master-essence",
        "metrics-essence",
        "policy-essence",
        "research-essence",
        "risk-essence",
        "roi-essence",
        "root-cause-essence",
        "rubric-essence",
        "safe-ai-essence",
        "security-essence",
        "stock-essence",
        "user-need-essence",
        "validation-essence",
        "vanilla-essence",
        "web-design-essence"
      ]
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "verified_facts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fact"
      }
    },
    "unverified_assumptions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/assumption"
      }
    },
    "residual_risks": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/risk"
      }
    },
    "recommended_actions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/action"
      }
    },
    "open_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source",
        "location",
        "quote"
      ],
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "location": {
          "type": "string",
          "minLength": 1
        },
        "quote": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "fact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "category",
        "statement",
        "evidence"
      ],
      "properties": {
        "category": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "assumption": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "why_unverified"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "why_unverified": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "statement",
        "severity",
        "evidence"
      ],
      "properties": {
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "low",
            "medium",
            "high",
            "unknown"
          ]
        },
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/evidence"
          }
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status",
        "owner"
      ],
      "properties": {
        "action": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "type": "string",
          "enum": [
            "proposed",
            "in_progress",
            "completed",
            "unknown"
          ]
        },
        "owner": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    }
  }
}
